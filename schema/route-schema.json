{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visa-route-schema",
  "title": "Visa Route",
  "description": "Schema for a single visa/permit route in the Netherlands",
  "type": "object",
  "required": ["id", "name", "authority", "applicant_profile", "eligibility", "required_documents", "fees", "processing_time", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique slug, e.g. partner-married-mvv",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable route name"
    },
    "authority": {
      "type": "object",
      "required": ["name", "country", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "applicant_profile": {
      "type": "object",
      "required": ["relationship_to_reference", "reference_holder_status"],
      "additionalProperties": false,
      "properties": {
        "relationship_to_reference": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "reference_holder_status": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "nationality_restrictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "age_minimum": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "eligibility": {
      "type": "object",
      "required": ["conditions"],
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "threshold": { "type": "string" },
              "uncertainty": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "mandatory": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "amount_eur"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "amount_eur": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "processing_time": {
      "type": "object",
      "required": ["legal_max_days"],
      "additionalProperties": false,
      "properties": {
        "legal_max_days": { "type": "integer", "minimum": 1 },
        "typical_days": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "notes": { "type": "string" }
        }
      }
    },
    "portal": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "notes": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "retrieved", "description"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "retrieved": { "type": "string", "format": "date" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
